    "\n",
    "<img src=\"https://github.com/jooneui/fig_collection/blob/main/scatter_mean_std_110107.png?raw=true\" align=\"left\" width = 40%>\n",
    "<img src=\"https://github.com/jooneui/fig_collection/blob/main/scatter_mean_std_150716.png?raw=true\" align=\"left\" width = 40%>"
